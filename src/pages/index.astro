---
import '../styles/global.css';

const nav = ['Work', 'Making', 'Reading'];

const career = [
  { years: '2009–2013', title: 'BA Communication & Media Studies', place: 'UCP · Lisbon, Portugal', kind: 'education' },
  { years: '2013–2014', title: 'MA Publishing', place: 'UCL · London, UK', kind: 'education' },
  { years: '2014–2018', title: 'Development Editor', place: 'ICE Publishing', kind: 'publishing' },
  { years: '2018–2020', title: 'Junior Metadata Analyst', place: 'Penguin Random House UK', kind: 'data' },
  { years: '2020–2022', title: 'Insight Analyst', place: 'Penguin Random House UK', kind: 'data' },
  { years: '2022–2024', title: 'Data Scientist', place: 'Penguin Random House UK', kind: 'data' },
  { years: '2024–2026', title: 'Senior Data Scientist', place: 'Penguin Random House UK', kind: 'data' },
  { years: '21 Sep 2026', title: 'Data Science Manager', place: 'Feedzai', kind: 'next' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Inês Pinheiro builds things with data, code, yarn and paint." />
    <title>Inês Pinheiro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,100..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header shell">
      <a class="wordmark" href="/">Inês Pinheiro</a>
      <nav aria-label="Primary navigation">
        {nav.map((item) => <a href={`/#${item.toLowerCase()}`}>{item}</a>)}
      </nav>
    </header>

    <main>
      <section class="hero shell">
        <div class="eyebrow">Data · code · books · making things</div>
        <h1>My name is Inês.<br />I build things.<br />Data is usually involved.</h1>
        <p class="hero-kicker">Some projects get quite silly.</p>
        <div class="hero-aside">
          <p>I came to data science through publishing and metadata. These days I work with data and code, usually where the problem is messy and the answer needs to be useful.</p>
          <div class="pattern" aria-hidden="true">× · × · · ×<br />· × · × × ·<br />× · · × · ×</div>
          <p>At home, software, yarn, paint and books all compete for space.</p>
        </div>
      </section>

      <section class="career" id="work">
        <div class="shell career-inner">
          <div class="section-index">01 / work</div>
          <div class="career-heading">
            <h2>Books, metadata, models.</h2>
            <p>I started in publishing and moved into data one role at a time. The thread has stayed the same: understanding messy information and making something useful from it.</p>
          </div>

          <div class="career-key" aria-label="Career map legend">
            <span><i class="key-dot education"></i>Education</span>
            <span><i class="key-dot publishing"></i>Publishing</span>
            <span><i class="key-dot data"></i>Data</span>
            <span><i class="key-dot next"></i>Next</span>
          </div>

          <div class="career-scroll">
            <div class="career-track">
              {career.map((item) => (
                <article class={`career-node ${item.kind}`}>
                  <div class="career-years">{item.years}</div>
                  <div class="career-dot" aria-hidden="true"></div>
                  <h3>{item.title}</h3>
                  <p>{item.place}</p>
                </article>
              ))}
              <aside class="apprenticeship">
                <span>2020–2022</span>
                <strong>Level 7 Data Science & AI Specialist</strong>
              </aside>
            </div>
          </div>
        </div>
      </section>

      <section class="recent-work">
        <div class="shell recent-work-inner">
          <div class="section-index">02 / recent work at Penguin Random House UK</div>
          <div class="recent-work-heading">
            <h2>What I was working on most recently.</h2>
            <p>By the end of my time at Penguin Random House UK, I was working mostly across long-form summarisation projects, while staying close to architecture, experiments and code review.</p>
          </div>

          <div class="work-grid">
            <article>
              <span>01 / long-form summarisation</span>
              <h3>Building safeguards around models that can be wrong.</h3>
              <p>Genre-specific pipelines, entity grounding, claim-level validation and deterministic checks each catch a different kind of failure.</p>
            </article>
            <article>
              <span>02 / Reviews Radar</span>
              <h3>Rebuilding an ML product at a new scale.</h3>
              <p>A data-source migration pushed each refresh from thousands of reviews to millions. I led the redesign of the data path, topic modelling and LLM stack.</p>
            </article>
            <article>
              <span>03 / forecasting</span>
              <h3>Making forecasts useful enough to act on.</h3>
              <p>Forecast MAPE improved from 42% to 35%, with SHAP explanations for finance and inventory teams.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="making" id="making">
        <div class="shell making-inner">
          <div class="section-index">03 / making</div>
          <div class="making-heading">
            <h2>Things I make because I want them to exist.</h2>
            <p>Sometimes that means software. Sometimes yarn or paint wins.</p>
          </div>
          <div class="making-grid">
            <div class="art art-code"><span>software / commonplace</span><strong>COMMON<br />PLACE</strong><small>a commonplace-book app for collecting ideas, connecting them and finding them again</small></div>
            <div class="art art-yarn"><span>knitting / in progress</span><div class="stitches">∨ ∨ ∨ ∨ ∨<br />∨ ∧ ∨ ∧ ∨<br />∧ ∨ ∧ ∨ ∧</div></div>
            <div class="art art-paint"><span>watercolour / studies</span><div class="wash"></div></div>
          </div>
        </div>
      </section>

      <section class="reading" id="reading">
        <div class="shell reading-inner">
          <div class="section-index">04 / reading</div>
          <div class="reading-copy">
            <h2>Books, essays and rabbit holes.</h2>
            <p>A record of what I read in 2026. Reviews are optional.</p>
          </div>
          <div class="reading-year" aria-label="2026">’26</div>
          <div class="mini-books" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        </div>
      </section>
    </main>

    <footer class="shell">
      <div>Inês Pinheiro · 2026</div>
      <div>Designed, coded & occasionally unravelled.</div>
    </footer>
  </body>
</html>
